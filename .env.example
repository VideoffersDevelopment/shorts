# Database
DATABASE_URL="postgresql://user:password@localhost:5432/videoshorts?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-random-secret-with-openssl-rand-base64-32"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
FACEBOOK_CLIENT_ID="your-facebook-client-id"
FACEBOOK_CLIENT_SECRET="your-facebook-client-secret"

# Cloudflare R2 Storage (Images/Avatars)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=videoshorts
R2_PUBLIC_URL=https://your-r2-public-url.r2.dev

# R2 Video Buckets (Stage 03)
R2_VIDEO_RAW_BUCKET=videoshorts-raw
R2_VIDEO_RAW_PUBLIC_URL=https://pub-93d4082b45d64b6691cc9cf76fbe880e.r2.dev

R2_VIDEO_HLS_BUCKET=videoshorts-hls
R2_VIDEO_HLS_PUBLIC_URL=https://cdn.videoffers.com
# Qencode (Video Transcoding)
# Note: Qencode does NOT support webhook signature verification
# Security is ensured by task_token validation (each token is unique)
QENCODE_API_KEY=your-qencode-api-key

# Przelewy24 (Primary Payment Provider)
PRZELEWY24_MERCHANT_ID=your-p24-merchant-id
PRZELEWY24_CRC=your-p24-crc-key
PRZELEWY24_API_KEY=your-p24-api-key

# Tpay (Secondary Payment Provider)
TPAY_MERCHANT_ID=your-tpay-merchant-id
TPAY_SECURITY_CODE=your-tpay-security-code
TPAY_API_KEY=your-tpay-api-key

# Inngest (Background Jobs)
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# Resend Email
RESEND_API_KEY=your-resend-api-key

# Set to 'true' to send real emails via Resend, 'false' or omit to log emails to console (dev mode)
RESEND_LIVE=false

# App Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Test Credentials (for E2E tests)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=testpassword

# Admin Credentials (for seeding)
ADMIN_USER_EMAIL=admin@videoffers.com
ADMIN_USER_PASSWORD=adminpassword
